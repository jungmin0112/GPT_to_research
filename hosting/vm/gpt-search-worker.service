[Unit]
Description=GPT to search incremental updates
After=gpt-search.service
Wants=gpt-search.service

[Service]
DynamicUser=true
WorkingDirectory=/srv/gpt-to-search
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/gpt-search/worker.env
ExecStart=/usr/bin/env node scripts/update-worker.mjs
Restart=on-failure
RestartSec=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
