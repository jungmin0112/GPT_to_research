# NEXT_PUBLIC_ prefix is browser-visible. Do NOT put secrets behind it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only Supabase Auth owner UUID.
OWNER_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID

# Set on the private persistent host only. Leave empty on a local PC.
PRIVATE_APP_HTTPS_ORIGIN=
# Supply WORKER_OWNER_EMAIL and WORKER_OWNER_PASSWORD only to the worker service.

# Windows owner-only tunnel. PRIVATE_APP_HTTPS_ORIGIN must match its public hostname.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_OWNER_EMAIL=
