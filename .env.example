# NEXT_PUBLIC_ prefix is browser-visible. Do NOT put secrets behind it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. These must not be exposed in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Main-session inference uses the local ChatGPT plan grant.

# Single-user allowlist; UUID from Supabase Auth. Required in production.
OWNER_USER_ID=YOUR_SUPABASE_AUTH_USER_UUID

# Validate available model IDs/account access before setting.
# Main-session model is selected from the authorized account catalog.
OPENAI_MODEL_MINI=YOUR_SUPPORTED_MODEL_ID
OPENAI_MODEL_ORGANIZE=YOUR_SUPPORTED_MODEL_ID
OPENAI_MODEL_CONFLICT=YOUR_SUPPORTED_MODEL_ID

# Internal cron authentication; generate a long random secret on deployment.
CRON_SECRET=YOUR_LONG_RANDOM_SECRET

# Reserved for future automated jobs. Plan HTTP requests omit max_tool_calls.
MONTHLY_AI_BUDGET_USD=10
MAX_WEB_SEARCH_CALLS_PER_REQUEST=3
MAX_AUTOMATED_RECORDS_PER_RUN=100
